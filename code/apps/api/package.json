{
  "name": "@pipeline-factory/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @pipeline-factory/contracts build && pnpm --filter @pipeline-factory/core build",
    "dev": "node --watch --conditions=pipeline-dev --import tsx/esm src/main.ts",
    "start": "node dist/main.js --config ../../config/pipeline-factory.config.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc --outDir dist"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.3.0",
    "@pipeline-factory/core": "workspace:*",
    "fastify": "^5.2.1",
    "zod": "^3.24.1",
    "@pipeline-factory/contracts": "workspace:*"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
