{
  "server": {
    "host": "127.0.0.1",
    "port": 4310
  },
  "web": {
    "host": "127.0.0.1",
    "port": 5173
  },
  "storage": {
    "databasePath": "../var/pipeline-factory.sqlite",
    "worktreeRoot": "../var/worktrees"
  },
  "project": {
    "root": "../../..",
    "commands": [
      {
        "commandId": "project.start",
        "argv": ["node", "scripts/start.mjs"],
        "environment": { "PATH": "/usr/local/bin:/usr/bin:/bin" }
      },
      {
        "commandId": "project.cleanup",
        "argv": ["node", "scripts/cleanup.mjs"],
        "environment": { "PATH": "/usr/local/bin:/usr/bin:/bin" }
      }
    ]
  },
  "model": {
    "backend": "codex-app-server",
    "codexAppServer": {
      "command": "codex",
      "args": ["app-server", "--stdio", "--enable", "default_mode_request_user_input"],
      "cwd": "../../..",
      "startupTimeoutMs": 15000,
      "requestTimeoutMs": 120000,
      "maxRestarts": 3,
      "clientName": "pipeline-factory",
      "clientVersion": "4.0.0"
    },
    "roles": {
      "explorer": {
        "model": "deepseek-v4-flash",
        "mode": "plan",
        "temperature": 0.1,
        "loopMode": "provider-controlled"
      },
      "executor": {
        "model": "deepseek-v4-flash",
        "mode": "default",
        "temperature": 0,
        "loopMode": "provider-controlled"
      }
    },
    "loop": {
      "maxSteps": 40,
      "maxDurationMs": 1800000,
      "maxRepeatedToolCalls": 2,
      "maxNoProgressSteps": 3,
      "requireFactoryToolGatewayForExecutor": false
    }
  },
  "runtime": {
    "globalConcurrency": 4,
    "projectConcurrency": 2,
    "defaultTimeoutMs": 120000,
    "maxAutoContinuationTurns": 4
  }
}
